<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" styleClass="fondo" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacion.controller.ProductoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Formulario a la izquierda, ícono de inventario a la derecha -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="10.0">
            <Label styleClass="titulo" text="Productos" />

            <GridPane hgap="10.0" vgap="10.0">
                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" promptText="P001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="txtNombre" promptText="Producto" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Precio:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Existencia:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtExistencia" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Ruta imagen:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField fx:id="txtRutaImagen" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <CheckBox fx:id="chkActivo" selected="true" text="Producto activo" GridPane.columnIndex="1" GridPane.rowIndex="3" />
              <columnConstraints>
                 <ColumnConstraints />
                 <ColumnConstraints />
                 <ColumnConstraints />
                 <ColumnConstraints />
              </columnConstraints>
              <rowConstraints>
                 <RowConstraints />
                 <RowConstraints />
                 <RowConstraints />
                 <RowConstraints />
              </rowConstraints>
            </GridPane>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <ImageView fitHeight="150.0" fitWidth="150.0" preserveRatio="true" smooth="true">
            <image>
                <Image url="@../icons/inventario.png" />
            </image>
        </ImageView>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox spacing="10.0">
        <Button onAction="#guardar" text="Guardar">
            <graphic>
                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../icons/agregar.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button onAction="#actualizar" text="Actualizar">
            <graphic>
                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../icons/actualizar.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button onAction="#eliminar" text="Eliminar">
            <graphic>
                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../icons/cerrar.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button onAction="#limpiar" text="Limpiar">
            <graphic>
                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../icons/limpiar.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button onAction="#volver" text="Volver" />
    </HBox>

    <!-- Búsqueda -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtBuscar" onAction="#buscar" promptText="🔍  Buscar por código, nombre o categoría..." styleClass="buscador" HBox.hgrow="ALWAYS" />
        <Button onAction="#buscar" text="Buscar" />
        <Button onAction="#limpiarBusqueda" text="Limpiar búsqueda" />
    </HBox>

    <!-- Filtros -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Estado:" />
        <ComboBox fx:id="cmbFiltroEstado" prefWidth="120.0" />
        <Label text="Categoría:" />
        <ComboBox fx:id="cmbFiltroCategoria" prefWidth="180.0" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblResultados" styleClass="resultados" />
    </HBox>

    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
            <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio" />
            <TableColumn fx:id="colExistencia" prefWidth="90.0" text="Existencia" />
            <TableColumn fx:id="colActivo" prefWidth="70.0" text="Activo" />
        </columns>
    </TableView>
</VBox>
